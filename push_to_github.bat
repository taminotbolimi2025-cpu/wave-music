@echo off
chcp 65001 >nul
title Отправка проекта на GitHub
cd /d "%~dp0"
echo ======================================================
echo   WAVE MUSIC: Отправка файлов в ваш GitHub репозиторий
echo ======================================================
echo.
echo Сейчас откроется окно авторизации GitHub в браузере.
echo Нажмите "Sign in with your browser" и разрешите доступ.
echo.
git push --force -u origin main
echo.
if %errorlevel% equ 0 (
    echo ======================================================
    echo  [УСПЕХ] Все файлы успешно загружены в GitHub!
    echo ======================================================
) else (
    echo ======================================================
    echo  [ОШИБКА] Не удалось отправить. Проверьте окно авторизации.
    echo ======================================================
)
echo.
pause
